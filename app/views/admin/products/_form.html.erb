<%= form_with model: [ :admin, product ], class: "max-w-2xl space-y-4 rounded-xl border border-stone-200 bg-white p-6" do |f| %>
  <% if product.errors.any? %><p class="text-red-700"><%= product.errors.full_messages.to_sentence %></p><% end %>
  <label class="block">Categoría <%= f.collection_select :category_id, Category.ordered, :id, :name, {}, class: "mt-1 w-full rounded border-stone-300" %></label>
  <label class="block">Nombre (máx. 24) <%= f.text_field :name, required: true, maxlength: 24, class: "mt-1 w-full rounded border-stone-300" %></label>
  <label class="block">Descripción (máx. 72) <%= f.text_field :description, maxlength: 72, class: "mt-1 w-full rounded border-stone-300" %></label>
  <div class="flex flex-wrap gap-4">
    <label>Orden <%= f.number_field :position, class: "mt-1 w-20 rounded border-stone-300" %></label>
    <label>Límite diario <%= f.number_field :daily_capacity, min: 0, placeholder: "sin límite", class: "mt-1 w-28 rounded border-stone-300" %></label>
    <label>Días de anticipación <%= f.number_field :lead_time_days, min: 0, class: "mt-1 w-20 rounded border-stone-300" %></label>
    <label class="flex items-center gap-2 self-end"><%= f.check_box :active %> Disponible</label>
  </div>

  <h2 class="pt-2 font-semibold">Presentaciones y precios</h2>
  <%= f.fields_for :variants do |v| %>
    <div class="flex flex-wrap items-end gap-3">
      <label>Nombre <%= v.text_field :name, placeholder: "Pieza, Paquete 250 g…", class: "mt-1 rounded border-stone-300" %></label>
      <label>Precio $ <%= v.number_field :price, step: 0.5, min: 0, class: "mt-1 w-28 rounded border-stone-300" %></label>
      <label class="flex items-center gap-1"><%= v.check_box :active %> Activa</label>
      <% if v.object.persisted? && v.object.order_items.none? %>
        <label class="flex items-center gap-1 text-red-700"><%= v.check_box :_destroy %> Quitar</label>
      <% end %>
    </div>
  <% end %>
  <p class="text-xs text-stone-500">Deja vacía la última fila si no quieres agregar otra presentación.</p>

  <div class="flex items-center gap-4">
    <%= f.submit "Guardar", class: "rounded bg-amber-900 px-4 py-2 text-white" %>
    <%= link_to "Volver", admin_categories_path, class: "text-stone-500" %>
  </div>
<% end %>
<% if product.persisted? %>
  <%= button_to "Eliminar producto", admin_product_path(product), method: :delete,
        form: { data: { turbo_confirm: "¿Eliminar «#{product.name}»?" } }, class: "mt-4 text-sm text-red-700" %>
<% end %>