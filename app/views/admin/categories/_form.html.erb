<%= form_with model: [ :admin, category ], class: "max-w-lg space-y-4 rounded-xl border border-stone-200 bg-white p-6" do |f| %>
  <% if category.errors.any? %><p class="text-red-700"><%= category.errors.full_messages.to_sentence %></p><% end %>
  <label class="block">Nombre <%= f.text_field :name, required: true, maxlength: 24, class: "mt-1 w-full rounded border-stone-300" %></label>
  <label class="block">Etiqueta (ej. «De siempre», «De temporada») <%= f.text_field :tagline, class: "mt-1 w-full rounded border-stone-300" %></label>
  <label class="block">Descripción (banner de temporada en la web) <%= f.text_area :description, rows: 2, class: "mt-1 w-full rounded border-stone-300" %></label>
  <label class="block">Orden <%= f.number_field :position, class: "mt-1 w-24 rounded border-stone-300" %></label>
  <label class="flex items-center gap-2"><%= f.check_box :active %> Visible</label>
  <fieldset class="rounded border border-stone-200 p-4">
    <label class="flex items-center gap-2"><%= f.check_box :seasonal %> De temporada (sólo se muestra entre estas fechas, cada año)</label>
    <div class="mt-3 flex gap-4">
      <label>Desde <%= f.date_field :starts_on, class: "mt-1 rounded border-stone-300" %></label>
      <label>Hasta <%= f.date_field :ends_on, class: "mt-1 rounded border-stone-300" %></label>
    </div>
  </fieldset>
  <div class="flex items-center gap-4">
    <%= f.submit "Guardar", class: "rounded bg-amber-900 px-4 py-2 text-white" %>
    <%= link_to "Volver", admin_categories_path, class: "text-stone-500" %>
  </div>
<% end %>
<% if category.persisted? %>
  <%= button_to "Eliminar categoría", admin_category_path(category), method: :delete,
        form: { data: { turbo_confirm: "¿Eliminar «#{category.name}»?" } }, class: "mt-4 text-sm text-red-700" %>
<% end %>