<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Amora Masa · Equipo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-stone-50 text-stone-800">
    <header class="border-b border-stone-200 bg-white">
      <nav class="mx-auto flex max-w-5xl items-center gap-5 px-5 py-3 text-sm">
        <%= link_to "Amora Masa", admin_root_path, class: "mr-auto font-semibold text-amber-900" %>
        <%= link_to "Pedidos", admin_orders_path %>
        <%= link_to "Producción", admin_production_path %>
        <%= link_to "Menú", admin_categories_path %>
        <%= link_to "Chats", admin_conversations_path %>
        <%= button_to "Salir", session_path, method: :delete, class: "text-stone-500 hover:text-stone-800" %>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-5 py-8">
      <% if notice %><p class="mb-4 rounded bg-green-50 px-4 py-2 text-green-800"><%= notice %></p><% end %>
      <% if alert %><p class="mb-4 rounded bg-red-50 px-4 py-2 text-red-800"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>